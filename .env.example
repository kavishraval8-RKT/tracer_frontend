# Copy to .env.local and fill in. Never commit real values.

# Public site URL: auth email links, Stripe redirects, and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers. All server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Device Code Flow — HS256 secret shared with the Python LLM backend.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The Python backend must set the SAME value in its own .env as TRACER_DEVICE_JWT_SECRET.
TRACER_DEVICE_JWT_SECRET=
